---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Skills from '../components/Skills.astro';
import Projects from '../components/Projects.astro';
import Certificates from '../components/Certificates.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout
	title="Ocid — Rosyid Ifni Andriansyah | Full-Stack & Mobile Developer"
	description="Portfolio of Rosyid Ifni Andriansyah (Ocid). Full-Stack & Mobile Developer from Indonesia. Specializing in Flutter, React, and modern web technologies."
>
	<Navbar />

	<main>
		<Hero />
		<div class="divider"></div>
		<About />
		<div class="divider"></div>
		<Skills />
		<div class="divider"></div>
		<Projects />
		<div class="divider"></div>
		<Certificates />
		<div class="divider"></div>
		<Contact />
	</main>

	<Footer />
</Layout>
