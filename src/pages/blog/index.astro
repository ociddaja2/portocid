---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.filter((p) => !p.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Blog — Rosyid Ifni Andriansyah (Ocid)">
	<Navbar />

	<main class="pt-24 pb-20">
		<div class="container-main">
			<div class="mb-12">
				<a href="/" class="inline-flex items-center gap-1.5 text-xs font-medium text-surface-500 hover:text-accent-light transition-colors mb-6">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
					</svg>
					Back to Home
				</a>
				<h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-white">
					Blog <span class="gradient-text">Posts</span>
				</h1>
				<p class="mt-3 text-sm text-surface-400 max-w-xl">
					Notes, tutorials, and reflections from my development journey.
				</p>
			</div>

			<div class="space-y-4">
				{posts.map((post) => (
					<a
						href={`/blog/${post.slug}`}
						class="glass-card glass-card-hover p-5 sm:p-6 flex items-center justify-between gap-6 group block"
					>
						<div class="flex-1 space-y-1.5">
							<h2 class="text-base font-bold text-white group-hover:text-accent-light transition-colors">
								{post.data.title}
							</h2>
							<p class="text-sm text-surface-500 line-clamp-2">
								{post.data.description}
							</p>
							{post.data.tags && post.data.tags.length > 0 && (
								<div class="flex flex-wrap gap-1.5 pt-1">
									{post.data.tags.map((tag: string) => (
										<span class="text-[10px] font-mono text-surface-500 bg-white/[0.03] border border-white/[0.05] rounded px-1.5 py-0.5">
											#{tag}
										</span>
									))}
								</div>
							)}
						</div>
						<div class="flex items-center gap-3 shrink-0">
							<span class="text-xs font-mono text-surface-600">
								{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
							</span>
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="text-surface-600 group-hover:text-accent-light group-hover:translate-x-1 transition-all">
								<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
							</svg>
						</div>
					</a>
				))}
			</div>

			{posts.length === 0 && (
				<div class="glass-card p-12 text-center">
					<p class="text-surface-500">No posts yet. Check back soon!</p>
				</div>
			)}
		</div>
	</main>

	<Footer />
</Layout>
