---
// Footer.astro — Minimal dark footer
const year = new Date().getFullYear();
---

<footer class="relative border-t border-white/[0.04]">
	<div class="container-main py-8">
		<div class="flex flex-col sm:flex-row items-center justify-between gap-4">
			<div class="flex items-center gap-2">
				<div class="flex h-6 w-6 items-center justify-center rounded-md bg-accent/10 border border-accent/20">
					<img src="/favicon.ico" alt="Logo" style="width:1rem;height:1rem;" />
				</div>
				<span class="text-xs text-surface-500">
					© {year} Rosyid Ifni Andriansyah. All rights reserved.
				</span>
			</div>

			<div class="flex items-center gap-4">
				<div class="h-3 w-px bg-white/[0.06]"></div>
				<a href="#home" class="text-[10px] font-mono text-surface-600 hover:text-accent-light transition-colors uppercase tracking-wider">
					Back to top
				</a>
			</div>
		</div>
	</div>
</footer>
