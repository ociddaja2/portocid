---
// Hero.astro — Full viewport cinematic hero
---

<section id="home" class="relative min-h-screen flex items-center overflow-hidden content-center">
	<!-- Interactive Antigravity Canvas Background -->
	<canvas id="antigravity-hero-canvas" class="absolute inset-0 w-full h-full z-0 pointer-events-none opacity-80"></canvas>

	<!-- Glowing Cursor Follower Spotlight -->
	<div id="antigravity-cursor-glow" class="absolute w-[350px] h-[350px] rounded-full pointer-events-none -translate-x-1/2 -translate-y-1/2 opacity-0 transition-opacity duration-700 z-0" style="background: radial-gradient(circle, rgba(59, 130, 246, 0.18) 0%, rgba(6, 182, 212, 0.08) 45%, transparent 70%);"></div>

	<!-- Grid Overlay -->
	<div class="absolute inset-0 bg-grid opacity-30 pointer-events-none"></div>

	<!-- Glow Spots -->
	<div class="glow-spot glow-blue w-[500px] h-[500px] -top-40 -left-40 pointer-events-none"></div>
	<div class="glow-spot glow-cyan w-[400px] h-[400px] top-1/3 -right-32 pointer-events-none"></div>
	<div class="glow-spot glow-purple w-[350px] h-[350px] -bottom-20 left-1/4 pointer-events-none"></div>

	<!-- Gradient fade at bottom -->
	<div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-[#060610] to-transparent pointer-events-none"></div>

	<div class="container-main relative z-10 pt-4">
		<div class="max-w-3xl mx-auto text-center">
			<!-- Status badge -->
			<div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/5 px-3.5 py-1.5 text-xs font-medium text-emerald-400 mb-8 animate-fade-in" style="animation-delay: 0.2s;">
				<span class="relative flex h-2 w-2">
					<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
					<span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
				</span>
				open for gawean
			</div>

			<!-- Terminal-style greeting -->
			<div class="font-mono text-sm text-surface-500 mb-3 animate-fade-in" style="animation-delay: 0.4s;">
				<span class="text-accent">~</span> $ whoami
			</div>

			<!-- Name -->
			<h1 class="sm:text-7xl md:text-6xl lg:text-7xl font-black tracking-tight text-white leading-[1.1] mb-6 animate-fade-in-up" style="animation-delay: 0.5s; opacity: 0; font-family: 'Baskervville', serif;">
				<span class="text-surface-350">Rosyid Ifni Andriansyah</span>
			</h1>

			<!-- Role -->
			<div class="flex items-center justify-center gap-3 mb-6 animate-fade-in-up" style="animation-delay: 0.7s; opacity: 0;">
				<div class="h-px w-12 bg-accent/50"></div>
				<p class="text-lg sm:text-xl font-medium text-surface-300">
					Full-Stack Developer
					<!-- <span class="relative inline-flex h-1 w-1 rounded-full bg-surface-300 mb-1"></span> -->
					<!-- Skill lain nanti -->
				</p>
				<div class="h-px w-12 bg-accent/50"></div>
			</div>

			<!-- CTAs -->
			<div class="flex flex-wrap items-center justify-center gap-4 animate-fade-in-up" style="animation-delay: 1.1s; opacity: 0;">
				<a href="#projects" class="btn-primary">
					<span>View Projects</span>
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3" />
					</svg>
				</a>
				<a href="#contact" class="btn-outline">
					<span>Get in Touch</span>
				</a>
			</div>

		</div>
	</div>

	<!-- Scroll indicator -->
	<div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-fade-in" style="animation-delay: 1.8s;">
		<span class="text-[10px] font-mono uppercase tracking-[0.2em] text-surface-600">Scroll</span>
		<div class="h-8 w-[1px] bg-gradient-to-b from-accent/60 to-transparent animate-pulse-slow"></div>
	</div>
</section>

<script is:inline>
	(() => {
		const section = document.getElementById('home');
		const canvas = document.getElementById('antigravity-hero-canvas');
		const glow = document.getElementById('antigravity-cursor-glow');
		if (!canvas || !section || !glow) return;

		const ctx = canvas.getContext('2d');
		let width, height;

		// Mouse state
		const mouse = {
			x: -1000,
			y: -1000,
			targetX: -1000,
			targetY: -1000,
			active: false,
			radius: 160
		};

		// Resize handler
		function resize() {
			width = canvas.width = section.offsetWidth;
			height = canvas.height = section.offsetHeight;
		}

		// Mouse events
		section.addEventListener('mousemove', (e) => {
			const rect = section.getBoundingClientRect();
			mouse.targetX = e.clientX - rect.left;
			mouse.targetY = e.clientY - rect.top;
			if (!mouse.active) {
				mouse.active = true;
				glow.style.opacity = '1';
			}
		});

		section.addEventListener('mouseleave', () => {
			mouse.active = false;
			glow.style.opacity = '0';
		});

		// Particle definition
		const particleCount = 50;
		class AntigravityParticle {
			constructor() {
				this.reset(true);
			}

			reset(initial = false) {
				this.x = Math.random() * width;
				this.y = initial ? Math.random() * height : height + 20;
				this.baseX = this.x;
				this.size = Math.random() * 2.5 + 1;
				this.speedY = Math.random() * 0.9 + 0.4; // Anti-gravity upward rise
				this.speedX = (Math.random() - 0.5) * 0.4;
				this.vx = 0;
				this.vy = 0;
				this.opacity = Math.random() * 0.6 + 0.25;
				this.color = Math.random() > 0.4 ? '59, 130, 246' : '6, 182, 212';
			}

			update() {
				// Anti-gravity base movement (rising up)
				this.y -= this.speedY;
				this.x += this.speedX;

				// Repulsion force from cursor (Google Antigravity physics)
				if (mouse.active) {
					const dx = this.x - mouse.x;
					const dy = this.y - mouse.y;
					const dist = Math.sqrt(dx * dx + dy * dy);

					if (dist < mouse.radius && dist > 0) {
						const force = (mouse.radius - dist) / mouse.radius;
						const angle = Math.atan2(dy, dx);
						const pushForce = force * 6;

						this.vx += Math.cos(angle) * pushForce * 0.3;
						this.vy += Math.sin(angle) * pushForce * 0.3;
					}
				}

				// Apply physics velocities & damping
				this.x += this.vx;
				this.y += this.vy;
				this.vx *= 0.92;
				this.vy *= 0.92;

				// Reset if out of bounds
				if (this.y < -20 || this.x < -20 || this.x > width + 20) {
					this.reset(false);
				}
			}

			draw() {
				ctx.beginPath();
				ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
				ctx.fillStyle = `rgba(${this.color}, ${this.opacity})`;
				ctx.shadowBlur = 10;
				ctx.shadowColor = `rgba(${this.color}, 0.9)`;
				ctx.fill();
				ctx.shadowBlur = 0;
			}
		}

		// Create particles
		let particles = [];
		function init() {
			resize();
			particles = [];
			for (let i = 0; i < particleCount; i++) {
				particles.push(new AntigravityParticle());
			}
		}

		// Animation loop
		function animate() {
			ctx.clearRect(0, 0, width, height);

			// Smooth cursor lerp
			if (mouse.active) {
				mouse.x += (mouse.targetX - mouse.x) * 0.15;
				mouse.y += (mouse.targetY - mouse.y) * 0.15;
				glow.style.left = `${mouse.x}px`;
				glow.style.top = `${mouse.y}px`;
			}

			// Draw interactive laser connections between cursor and nearby particles
			if (mouse.active) {
				for (let i = 0; i < particles.length; i++) {
					const p = particles[i];
					const dx = p.x - mouse.x;
					const dy = p.y - mouse.y;
					const dist = Math.sqrt(dx * dx + dy * dy);

					if (dist < mouse.radius) {
						const alpha = (1 - dist / mouse.radius) * 0.4;
						ctx.beginPath();
						ctx.moveTo(mouse.x, mouse.y);
						ctx.lineTo(p.x, p.y);
						ctx.strokeStyle = `rgba(59, 130, 246, ${alpha})`;
						ctx.lineWidth = 0.8;
						ctx.stroke();
					}
				}
			}

			// Draw inter-particle constellation lines
			for (let i = 0; i < particles.length; i++) {
				for (let j = i + 1; j < particles.length; j++) {
					const dx = particles[i].x - particles[j].x;
					const dy = particles[i].y - particles[j].y;
					const dist = Math.sqrt(dx * dx + dy * dy);

					if (dist < 90) {
						ctx.beginPath();
						ctx.moveTo(particles[i].x, particles[i].y);
						ctx.lineTo(particles[j].x, particles[j].y);
						ctx.strokeStyle = `rgba(6, 182, 212, ${0.12 * (1 - dist / 90)})`;
						ctx.lineWidth = 0.5;
						ctx.stroke();
					}
				}
			}

			// Update & render particles
			particles.forEach(p => {
				p.update();
				p.draw();
			});

			requestAnimationFrame(animate);
		}

		window.addEventListener('resize', resize);
		init();
		animate();
	})();
</script>
