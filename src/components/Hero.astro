---
// Hero.astro — Full viewport cinematic hero
---

<section id="home" class="relative min-h-screen flex items-center overflow-hidden">
	<!-- Background Effects -->
	<div class="absolute inset-0 bg-grid opacity-40"></div>
	<div class="glow-spot glow-blue w-[500px] h-[500px] -top-40 -left-40"></div>
	<div class="glow-spot glow-cyan w-[400px] h-[400px] top-1/3 -right-32"></div>
	<div class="glow-spot glow-purple w-[350px] h-[350px] -bottom-20 left-1/4"></div>

	<!-- Gradient fade at bottom -->
	<div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-[#060610] to-transparent"></div>

	<div class="container-main relative z-10 pt-20">
		<div class="max-w-3xl">
			<!-- Status badge -->
			<div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/5 px-3.5 py-1.5 text-xs font-medium text-emerald-400 mb-8 animate-fade-in" style="animation-delay: 0.2s;">
				<span class="relative flex h-2 w-2">
					<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
					<span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
				</span>
				Available for projects
			</div>

			<!-- Terminal-style greeting -->
			<div class="font-mono text-sm text-surface-500 mb-3 animate-fade-in" style="animation-delay: 0.4s;">
				<span class="text-accent">~</span> $ whoami
			</div>

			<!-- Name -->
			<h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black tracking-tight text-white leading-[1.1] mb-6 animate-fade-in-up" style="animation-delay: 0.5s; opacity: 0;">
				Rosyid Ifni<br />
				<span class="gradient-text">Andriansyah</span>
			</h1>

			<!-- Role -->
			<div class="flex items-center gap-3 mb-6 animate-fade-in-up" style="animation-delay: 0.7s; opacity: 0;">
				<div class="h-px w-12 bg-accent/50"></div>
				<p class="text-lg sm:text-xl font-medium text-surface-300">
					Full-Stack & Mobile Developer
				</p>
			</div>

			<!-- Bio -->
			<p class="text-base sm:text-lg leading-relaxed text-surface-400 max-w-xl mb-10 animate-fade-in-up" style="animation-delay: 0.9s; opacity: 0;">
				Building high-performance mobile apps with <span class="text-white font-medium">Flutter</span> and modern web experiences with <span class="text-white font-medium">React & Astro</span>. Computer Science student exploring the intersection of software, hardware, and security.
			</p>

			<!-- CTAs -->
			<div class="flex flex-wrap items-center gap-4 animate-fade-in-up" style="animation-delay: 1.1s; opacity: 0;">
				<a href="#projects" class="btn-primary">
					<span>View Projects</span>
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3" />
					</svg>
				</a>
				<a href="#contact" class="btn-outline">
					<span>Get in Touch</span>
				</a>
			</div>

			<!-- Quick Stats -->
			<div class="flex items-center gap-8 mt-14 pt-8 border-t border-white/[0.06] animate-fade-in-up" style="animation-delay: 1.3s; opacity: 0;">
				<div>
					<div class="text-2xl font-bold text-white">2+</div>
					<div class="text-xs text-surface-500 font-medium mt-0.5">Projects Built</div>
				</div>
				<div class="h-8 w-px bg-white/[0.06]"></div>
				<div>
					<div class="text-2xl font-bold text-white">8+</div>
					<div class="text-xs text-surface-500 font-medium mt-0.5">Technologies</div>
				</div>
				<div class="h-8 w-px bg-white/[0.06]"></div>
				<div>
					<div class="text-2xl font-bold text-white">CS</div>
					<div class="text-xs text-surface-500 font-medium mt-0.5">Student</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Scroll indicator -->
	<div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-fade-in" style="animation-delay: 1.8s;">
		<span class="text-[10px] font-mono uppercase tracking-[0.2em] text-surface-600">Scroll</span>
		<div class="h-8 w-[1px] bg-gradient-to-b from-accent/60 to-transparent animate-pulse-slow"></div>
	</div>
</section>
